# Cloudflare Pages: cabeçalhos de segurança e cache
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# o index muda a cada versão: o navegador sempre confere se há versão nova
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# v0.183: o frontend de integrações muda com frequência.
# Não servir JavaScript antigo que ainda chama /conexoes/iniciar para Meta.
/assets/atendimento.js
  Cache-Control: no-cache, must-revalidate

# v0.235: o formulário público pode ser colocado dentro de outra página (embed). Só este endereço; o resto continua bloqueado.
/formulario
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  Cache-Control: no-cache
